<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Nuplane Runtime</Title>
    <Description>Core reconciliation runtime for Nuplane, including desired-state convergence, transactional package application, and change events.</Description>
    <PackageTags>$(NuplanePackageTags);runtime;reconciliation;package-management;events</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="..\Nuplane.Abstractions\Nuplane.Abstractions.csproj" />
    <ProjectReference Include="..\Nuplane.Store\Nuplane.Store.csproj" />
    <ProjectReference Include="..\Nuplane.Loading\Nuplane.Loading.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuplane.Runtime.Tests" />
    <InternalsVisibleTo Include="Nuplane.Integration.Tests" />
    <InternalsVisibleTo Include="Nuplane.NuGet" />
    <InternalsVisibleTo Include="Nuplane.NuGet.Tests" />
    <InternalsVisibleTo Include="Nuplane" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
