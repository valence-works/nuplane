<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Nuplane Directory Sources</Title>
    <Description>Directory-backed feed support for Nuplane, including local .nupkg discovery and file-system change monitoring.</Description>
    <PackageTags>$(NuplanePackageTags);directory-feed;watcher;local-feed;nupkg</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuplane" />
    <InternalsVisibleTo Include="Nuplane.Sources.Directory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="..\Nuplane\Nuplane.csproj" />
  </ItemGroup>

</Project>

