<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Nuplane Directory Sources Hosting</Title>
    <Description>Builder integration extensions for Nuplane directory-backed feeds, providing fluent NuplaneBuilder APIs that delegate to module-owned registration services.</Description>
    <PackageTags>$(NuplanePackageTags);directory-feed;builder;hosting;extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuplane.Runtime.Tests" />
    <InternalsVisibleTo Include="Nuplane.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <ProjectReference Include="..\Nuplane\Nuplane.csproj" />
    <ProjectReference Include="..\Nuplane.Sources.Directory\Nuplane.Sources.Directory.csproj" />
  </ItemGroup>

</Project>
