<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Nuplane Loading Hosting</Title>
    <Description>Hosting and builder extensions for enabling Nuplane package autoloading and load-event observers in .NET applications.</Description>
    <PackageTags>$(NuplanePackageTags);loading;hosting;extensions;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuplane.Loading.Tests" />
    <InternalsVisibleTo Include="Nuplane.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <ProjectReference Include="..\Nuplane\Nuplane.csproj" />
    <ProjectReference Include="..\Nuplane.Runtime\Nuplane.Runtime.csproj" />
    <ProjectReference Include="..\Nuplane.Loading\Nuplane.Loading.csproj" />
  </ItemGroup>
</Project>
