<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Nuplane NuGet Integration</Title>
    <Description>NuGet protocol integration for resolving package versions and acquiring packages for Nuplane feeds.</Description>
    <PackageTags>$(NuplanePackageTags);nuget;feeds;package-resolution;package-download</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Versioning" />
    <ProjectReference Include="..\Nuplane.Runtime\Nuplane.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nuplane.NuGet.Tests" />
    <InternalsVisibleTo Include="Nuplane" />
  </ItemGroup>

</Project>
