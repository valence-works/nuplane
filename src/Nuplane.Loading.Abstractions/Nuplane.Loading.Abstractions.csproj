<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <rootnamespace>Nuplane.Loading</rootnamespace>
        <Title>Nuplane Loading Abstractions</Title>
        <Description>Contracts and models for Nuplane runtime assembly loading, package load events, and shared assembly policies.</Description>
        <PackageTags>$(NuplanePackageTags);loading;assemblyloadcontext;contracts;plugins</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nuplane.Loading" />
        <InternalsVisibleTo Include="Nuplane.Loading.Tests" />
        <InternalsVisibleTo Include="Nuplane.Integration.Tests" />
        <InternalsVisibleTo Include="Nuplane.Runtime.Tests" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nuplane.Abstractions\Nuplane.Abstractions.csproj"/>
    </ItemGroup>

</Project>
